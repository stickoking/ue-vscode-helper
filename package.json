{
  "name": "ue-vscode-helper",
  "displayName": "Unreal Engine VS Code / Cursor Helper",
  "description": "Dual-host Unreal IntelliSense setup for VS Code (Microsoft C++) and Cursor (clangd + slim BuildRules IntelliSense), plus excludes and Git init",
  "version": "0.2.7",
  "publisher": "stickoking",
  "repository": {
    "type": "git",
    "url": "https://github.com/stickoking/ue-vscode-helper.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:ue-vscode-helper.setup",
    "onCommand:ue-vscode-helper.initGit",
    "workspaceContains:*.uproject"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ue-vscode-helper.setup",
        "title": "Unreal: Setup IntelliSense + Excludes",
        "category": "Unreal Engine"
      },
      {
        "command": "ue-vscode-helper.initGit",
        "title": "Unreal: Init Git + .gitignore",
        "category": "Unreal Engine"
      }
    ],
    "configuration": {
      "title": "UE VS Code / Cursor Helper",
      "properties": {
        "ue-vscode-helper.enginePath": {
          "type": "string",
          "default": "C:\\Program Files\\Epic Games\\UE_5.4",
          "description": "Fallback path to your Unreal Engine installation when EngineAssociation cannot be resolved from the .uproject"
        },
        "ue-vscode-helper.preferHost": {
          "type": "string",
          "enum": [
            "auto",
            "cursor",
            "vscode"
          ],
          "default": "auto",
          "description": "Which IntelliSense profile to apply. auto detects Cursor vs VS Code from the app name."
        },
        "ue-vscode-helper.restoreModuleRules": {
          "type": "boolean",
          "default": true,
          "description": "On Cursor setup, run UE-bundled `dotnet restore` on the slim `.vscode/<Project>.BuildRules.IntelliSense.csproj` (wrapped by a sibling .sln as dotnet.defaultSolution — not the full Intermediate ModuleRules). Timeout 90s; non-fatal. Avoids indexing thousands of Engine Build.cs via UE5Rules."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsix": "npx --yes @vscode/vsce package",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.9",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "eslint": "^8.56.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
